# Oathrion — production environment template. COPY to placet.env and FILL; never commit placet.env.
# Generate values with: ./scripts/generate-secrets.sh
# Every <...> value is a placeholder: replace it before starting.

# Public DNS name served by the TLS proxy (Caddy obtains the certificate).
OATHRION_DOMAIN=placet.example.com

# PostgreSQL password for the bundled database (docker-compose.yml).
POSTGRES_PASSWORD=<generated-by-scripts/generate-secrets.sh>

# Signs console sessions. 32+ random bytes. Changing it signs everyone out.
OATHRION_SESSION_SECRET=<generated-by-scripts/generate-secrets.sh>

# Accounts live in the database: no password in this file. Invite each customer with
#   docker compose --env-file placet.env exec placet node dist/workspace-create.cjs --org "Acme" --email admin@acme.com
# which prints a one-time link (7 days). See docs/DEMARRAGE.md.
OATHRION_ACCOUNTS=database
# The public HTTPS address: used in invitation links and as the OAuth return
# (<url>/api/connectors/oauth/callback).
OATHRION_PUBLIC_URL=https://placet.example.com
# Legacy alternative, for a local trial only (a plaintext password in the environment):
# OATHRION_CONSOLE_USERS=Acme Corp/admin@acme.example:admin:<generated-admin-password>

# Optional bootstrap API key (agents should get keys bound to them from the console).
OATHRION_API_KEYS=

# Optional: action destinations. In production EVERY entry must name the tenants
# allowed to use it ("organizations": ["org_acme_corp"]) — the server refuses to boot
# otherwise, because an unscoped destination would be shared by all tenants.
# OATHRION_DESTINATIONS=[{"id":"acme-erp","url":"https://mcp.erp.acme.example","organizations":["org_acme_corp"]}]
# Optional: declared tools. Wires a verb to YOUR MCP tool by configuration; the
# "destination" must be one of the ids above, and each argument is a projection of a
# field Oathrion already holds. An unknown argument source or an unregistered
# destination stops the boot. Proof: npm run verify:tools — see docs/mcp.md.
# OATHRION_TOOLS=[{"id":"acme_refund","label":"Acme refunds","destination":"acme-erp","tool":"refunds.create","actions":["refund"],"arguments":{"customer":"target","amount":"metadata.amount","currency":"currency"}}]

# Connecteurs : clé de chiffrement du coffre de credentials. OBLIGATOIRE pour connecter
# GitHub, Slack, Linear ou Stripe (sinon 503 nommant cette variable). Donnée par
# scripts/generate-secrets.sh. Ne la régénérez JAMAIS sur une base existante : les jetons
# déjà scellés deviendraient illisibles. Voir docs/connectors.md pour la rotation.
OATHRION_KEK=<generated-by-scripts/generate-secrets.sh>
# « Connecter Slack / Linear » en un clic : les applications OAuth de l'exploitant.
# Sans elles, la console guide la connexion par jeton. Voir docs/connectors.md §0.
# OATHRION_SLACK_CLIENT_ID=
# OATHRION_SLACK_CLIENT_SECRET=
# OATHRION_LINEAR_CLIENT_ID=
# OATHRION_LINEAR_CLIENT_SECRET=
# OATHRION_GITHUB_API_ORIGIN=https://api.github.com
# Stripe : clés de TEST seulement, sauf décision explicite de l'exploitant (argent réel).
# OATHRION_STRIPE_ALLOW_LIVE=false
# Réconciliation périodique (ce qui s'est fait sans Oathrion) : 1 h par défaut, 0 la coupe.
# OATHRION_RECONCILE_INTERVAL_MS=3600000
# Refus immédiat (503 overloaded) au-delà de N requêtes en cours ; 0 coupe. 256 par défaut.
# OATHRION_MAX_IN_FLIGHT=256
# Patience du reçu d'une action déjà exécutée quand la base est saturée. 60 s par défaut.
# OATHRION_RECEIPT_PATIENCE_MS=60000
# Recherche des actions sans reçu, et alerte une fois par action : 5 min par défaut, 0 coupe.
# OATHRION_RECEIPT_GAP_INTERVAL_MS=300000
# OATHRION_MCP_ALLOWED_DESTINATIONS=https://mcp.erp.acme.example

# Fail-closed defaults (leave as is unless you know why).
RATE_LIMIT_FAIL_MODE=closed
