{
  "name": "oathrion",
  "version": "0.1.0-preview.6",
  "description": "Oathrion (Autonomous Risk & Integrity Authority) — the control plane for autonomous AI. Every agent action is submitted for a decision before it can reach a tool.",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "bootstrap:admin": "tsx script/bootstrap-admin.ts",
    "workspace:create": "tsx script/workspace-create.ts",
    "package": "tsx script/package-release.ts",
    "scan:secrets": "tsx script/secret-scan.ts",
    "sbom": "tsx script/sbom.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:postgres": "OATHRION_REQUIRE_POSTGRES=true vitest run server/test/postgres.test.ts",
    "verify:postgres": "OATHRION_REQUIRE_POSTGRES=true vitest run server/test/postgres.test.ts && npm run smoke:postgres",
    "cli": "tsx cli/bin.ts",
    "demo:wrap": "tsx script/demo-wrap.ts",
    "score:fluidite": "node script/score-fluidite.mjs",
    "pack:oathrion": "tsx script/pack-oathrion.ts",
    "public:prepare": "tsx script/prepare-public.ts",
    "test:python": "python3 -m unittest discover -s sdk/python -v",
    "test:watch": "vitest",
    "test:mutations": "tsx script/mutation-audit.ts",
    "chaos": "tsx script/chaos.ts",
    "chaos:postgres": "tsx script/chaos-postgres.ts",
    "smoke": "tsx script/smoke.ts",
    "mcp:local": "tsx script/mcp-local-demo.ts",
    "bench": "tsx script/bench-daily-spend.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "pilot": "tsx script/pilot-sim.ts",
    "demo": "tsx script/demo-5min.ts",
    "migrate:postgres": "tsx script/migrate-postgres.ts",
    "smoke:postgres": "tsx script/smoke-postgres.ts",
    "e2e": "tsx script/e2e-enterprise.ts",
    "e2e:instances": "tsx script/e2e-two-instances.ts",
    "e2e:identity": "tsx script/e2e-identity-instances.ts",
    "e2e:currency": "tsx script/e2e-currency.ts",
    "package:zip": "tsx script/package-release.ts --zip",
    "e2e:multitenant": "tsx script/e2e-multitenant.ts",
    "verify:prod-config": "tsx script/verify-production-config.ts",
    "tenant:export": "tsx script/tenant-export.ts",
    "conformance": "tsx conformance/run.ts",
    "verify:backup": "tsx script/verify-backup.ts",
    "verify:compose": "tsx script/verify-compose.ts",
    "verify:mcp": "tsx script/verify-mcp-downstream.ts",
    "verify:tools": "tsx script/verify-tool-registry.ts",
    "verify:github": "tsx script/verify-github-connector.ts",
    "verify:stripe": "tsx script/verify-stripe.ts",
    "verify:openai": "tsx script/verify-openai.ts",
    "verify:slack": "tsx script/verify-slack.ts",
    "verify:launch": "tsx script/verify-launch.ts",
    "verify:intercept": "tsx script/verify-intercept.ts",
    "mcp:discover": "tsx script/discover-mcp-tools.ts",
    "pilot:up": "bash deploy/scripts/pilot-up.sh",
    "pilot:logs": "docker compose -p placet-local -f deploy/docker-compose.local.yml --env-file deploy/placet.local.env logs -f placet",
    "pilot:down": "docker compose -p placet-local -f deploy/docker-compose.local.yml --env-file deploy/placet.local.env down",
    "pilot:destroy": "docker compose -p placet-local -f deploy/docker-compose.local.yml --env-file deploy/placet.local.env down -v",
    "verify:obs": "tsx script/verify-observability.ts",
    "verify:dr": "tsx script/verify-disaster-recovery.ts",
    "verify:upgrade": "tsx script/verify-upgrade.ts",
    "verify:soak": "tsx script/verify-soak.ts",
    "profile:intercept": "tsx script/profile-intercept.ts",
    "verify:load": "tsx script/verify-load.ts",
    "verify:faults": "tsx script/verify-faults.ts",
    "audit:chains": "tsx script/audit-chains.ts",
    "verify:chain-audit": "tsx script/verify-chain-audit.ts",
    "packs": "tsx script/packs.ts",
    "build:site": "npm run build && tsx script/build-site.ts",
    "tenant:purge": "tsx script/tenant-purge.ts",
    "verify:erasure": "tsx script/verify-erasure.ts"
  },
